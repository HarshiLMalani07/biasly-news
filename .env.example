# biasly environment variables.
#
# Canonical list per AGENTS.md section 21. Only NEXT_PUBLIC_* values may reach
# browser code; everything else is server-only. CRON_SECRET is injected by
# Vercel and must not be added to .env.local.
#
# The Supabase, Oxylabs, OpenAI and admin-secret rows from the AGENTS.md table
# are appended here by the tasks that introduce those features.

# --- Clerk (authentication) -------------------------------------------------
# Get these from https://dashboard.clerk.com -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_<your-clerk-secret-key>

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Supabase (database) ----------------------------------------------------
# Get these from https://supabase.com/dashboard -> Project Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# Server only. Bypasses RLS - never expose to browser code (AGENTS.md section 21).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# --- Oxylabs (Web Scraper API) ----------------------------------------------
# Get these from https://dashboard.oxylabs.io -> Web Scraper API -> users.
# Server only. Never expose to browser code (AGENTS.md section 21).
OXY_WSA_USERNAME=<your-oxylabs-web-scraper-api-username>
OXY_WSA_PASSWORD=<your-oxylabs-web-scraper-api-password>

# --- Pipeline admin secret --------------------------------------------------
# Sent as the `x-biasly-admin-secret` header on every action route that starts
# or mutates work (AGENTS.md section 15). Server only, never in a query string.
BIASLY_ADMIN_SECRET=<a-long-random-string>
